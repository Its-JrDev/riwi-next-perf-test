# Copy this file to `.env.local` (or `.env`) and fill in the values.
# This project uses PostgreSQL + Prisma and its own JWT-based auth.

# Database connection used by Prisma and the app.
# For Supabase, use the transaction/pooler URL in DATABASE_URL and the direct URL in DIRECT_URL.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local development fallback (Docker Compose or local Postgres)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# JWT secrets used by the app to sign access and refresh tokens.
# Generate long random values and keep them secret.
JWT_ACCESS_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"

# Optional expiration overrides (defaults are already defined in src/lib/auth.ts)
# ACCESS_TOKEN_EXPIRES_IN="15m"
# REFRESH_TOKEN_EXPIRES_IN="7d"

# Optional server port for local runs (defaults to 3000)
# PORT=3000
